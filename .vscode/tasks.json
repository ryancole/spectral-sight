{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pytest",
      "type": "process",
      // Resolves to whatever interpreter is selected, so it follows .venv.
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "install (editable, capture + dev)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-e", ".[capture,dev]"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "fetch champion icons",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["tools/fetch_icons.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
